# ---------------------------------------------------------------------------
# Community Space API - environment configuration
# Copy this file to `.env` (npm run setup does it for you) and adjust values.
# ---------------------------------------------------------------------------

# SQLite database file (relative to apps/api)
DATABASE_URL="file:./dev.db"

PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Secret used to sign JWT access tokens. Change it for any non-demo usage.
JWT_SECRET=community-space-dev-secret-change-me
JWT_EXPIRES_IN=7d

# ---------------------------------------------------------------------------
# AI provider configuration
#
# AI_PROVIDER = auto        -> use Hugging Face when HUGGINGFACE_API_KEY is set,
#                              otherwise transparently fall back to the built-in
#                              local provider (no network, no key required).
# AI_PROVIDER = huggingface -> force Hugging Face.
# AI_PROVIDER = local       -> force the offline provider.
# ---------------------------------------------------------------------------
AI_PROVIDER=auto

# Free Hugging Face token (https://huggingface.co/settings/tokens). Optional.
HUGGINGFACE_API_KEY=

HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_SUMMARIZATION_MODEL=facebook/bart-large-cnn
HF_CHAT_MODEL=meta-llama/Llama-3.2-3B-Instruct

# Milliseconds before an AI call gives up and the local fallback takes over.
AI_TIMEOUT_MS=15000

# Optional: Cognee knowledge-graph memory
# Get these from the API Keys page in Cognee Cloud.
# COGNEE_BASE_URL looks like https://<your-tenant>.aws.cognee.ai/api/v1
COGNEE_API_KEY=
COGNEE_TENANT_ID=
COGNEE_BASE_URL=
COGNEE_DATASET=community_space
