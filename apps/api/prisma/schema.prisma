// Community Space - data model
// SQLite is used so the whole project runs locally with zero external services.
// Vector embeddings are stored as JSON strings and compared in-memory (see VectorMath).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("MEMBER") // MEMBER | ORGANIZER | ADMIN
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile       Profile?
  memberships   Membership[]
  events        Event[]        @relation("EventOrganizer")
  resources     Resource[]
  announcements Announcement[]
  posts         Post[]
  reports       Report[]       @relation("ReportAuthor")
  reviewedRepos Report[]       @relation("ReportReviewer")
  interactions  Interaction[]
  rsvps         Rsvp[]
  projects      Project[]
}

model Profile {
  id            String   @id @default(cuid())
  userId        String   @unique
  headline      String   @default("")
  bio           String   @default("")
  location      String   @default("")
  availability  String   @default("OPEN") // OPEN | BUSY | HIRING | LOOKING_FOR_TEAM
  skills        String   @default("[]") // JSON string[]
  interests     String   @default("[]") // JSON string[]
  expertise     String   @default("[]") // JSON string[]
  links         String   @default("{}") // JSON record
  experienceYrs Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Community {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  category    String
  tags        String   @default("[]") // JSON string[]
  location    String   @default("Online")
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships   Membership[]
  events        Event[]
  resources     Resource[]
  announcements Announcement[]
  posts         Post[]
}

model Membership {
  id          String   @id @default(cuid())
  userId      String
  communityId String
  role        String   @default("MEMBER") // MEMBER | ORGANIZER
  joinedAt    DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([userId, communityId])
}

model Event {
  id          String   @id @default(cuid())
  communityId String
  organizerId String
  title       String
  description String
  summary     String   @default("")
  mode        String   @default("ONLINE") // ONLINE | OFFLINE | HYBRID
  venue       String   @default("Online")
  startsAt    DateTime
  endsAt      DateTime
  capacity    Int      @default(100)
  tags        String   @default("[]") // JSON string[]
  bannerUrl   String   @default("") // AI-generated banner (empty = none)
  status      String   @default("PUBLISHED") // DRAFT | PUBLISHED | CANCELLED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  organizer User      @relation("EventOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)
  rsvps     Rsvp[]
}

model Rsvp {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  status    String   @default("GOING") // GOING | INTERESTED | CANCELLED
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model Resource {
  id          String   @id @default(cuid())
  communityId String
  authorId    String
  title       String
  description String
  summary     String   @default("")
  url         String   @default("")
  type        String   @default("ARTICLE") // ARTICLE | VIDEO | REPO | COURSE | TOOL | DOC
  tags        String   @default("[]") // JSON string[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model Announcement {
  id          String   @id @default(cuid())
  communityId String
  authorId    String
  title       String
  body        String
  summary     String   @default("")
  priority    String   @default("NORMAL") // NORMAL | HIGH | URGENT
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model Post {
  id          String   @id @default(cuid())
  communityId String
  authorId    String
  title       String
  body        String
  summary     String   @default("")
  tags        String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model Project {
  id          String   @id @default(cuid())
  ownerId     String
  title       String
  description String
  neededSkills String  @default("[]") // JSON string[]
  teamSize    Int      @default(4)
  status      String   @default("OPEN") // OPEN | CLOSED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}

/// Moderation: a report raised against any indexable entity.
model Report {
  id         String   @id @default(cuid())
  targetType String // EVENT | RESOURCE | ANNOUNCEMENT | POST | PROFILE | COMMUNITY
  targetId   String
  targetTitle String  @default("")
  reporterId String
  reason     String // SPAM | MISLEADING | DUPLICATE | INAPPROPRIATE | OTHER
  details    String   @default("")
  status     String   @default("PENDING") // PENDING | REVIEWING | RESOLVED | DISMISSED
  aiVerdict  String   @default("") // AI triage label
  aiScore    Float    @default(0)
  aiRationale String  @default("")
  reviewerId String?
  resolution String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  reporter User  @relation("ReportAuthor", fields: [reporterId], references: [id], onDelete: Cascade)
  reviewer User? @relation("ReportReviewer", fields: [reviewerId], references: [id])
}

/// Generic vector index over every searchable entity (single source of truth for semantic search + RAG).
model EmbeddingRecord {
  id         String   @id @default(cuid())
  entityType String // EVENT | RESOURCE | ANNOUNCEMENT | POST | COMMUNITY | PROFILE | PROJECT
  entityId   String
  chunkIndex Int      @default(0)
  content    String
  vector     String // JSON number[]
  dimension  Int
  model      String
  metadata   String   @default("{}") // JSON record
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([entityType, entityId, chunkIndex])
  @@index([entityType])
}

/// Engagement signal used by recommendations + organizer analytics.
model Interaction {
  id         String   @id @default(cuid())
  userId     String?
  entityType String
  entityId   String
  action     String // VIEW | SEARCH | RSVP | JOIN | SAVE | ASK
  weight     Float    @default(1)
  context    String   @default("")
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
  @@index([action])
}

/// Every assistant question is logged so organizers can see frequently requested information.
model AssistantQuery {
  id           String   @id @default(cuid())
  userId       String?
  question     String
  answer       String
  sources      String   @default("[]") // JSON array of source refs
  topicLabel   String   @default("")
  latencyMs    Int      @default(0)
  provider     String   @default("")
  createdAt    DateTime @default(now())
}
